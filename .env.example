# Exact immutable candidate images from one release descriptor.
V2_CONTROL_IMAGE=ghcr.io/owner/codex-cpa-control:sha256-example
V2_WEB_IMAGE=ghcr.io/owner/codex-cpa-web:sha256-example
V2_GATEWAY_IMAGE=ghcr.io/owner/codex-cpa-gateway:sha256-example
V2_EDGE_IMAGE=ghcr.io/owner/codex-cpa-edge:sha256-example

# Candidate process identity and isolated host entrypoint.
V2_COMPOSE_PROJECT_NAME=cliproxy-v2
V2_INSTANCE_NAME=cliproxy-v2
V2_RUNTIME_OWNER=go-v2
# Gives Compose dependency health checks enough time for Admin to join the
# explicitly activated runtime lease; steady-state workers renew at their own TTL.
V2_OWNERSHIP_ACTIVATION_TTL=2m
V2_DEPLOY_ROOT=/opt/codex-cpa-cluster
# Keep loopback for ordinary Test validation. Set an explicit target LAN address
# only when an operator has approved direct access to the candidate.
V2_PUBLIC_BIND_ADDRESS=127.0.0.1
V2_PUBLIC_PROBE_HOST=127.0.0.1
V2_PUBLIC_PORT=28317
V2_INTERNAL_PORT=28319
# Candidate Admin receives only a project-scoped read proxy. The real host
# socket is mounted into that proxy, never into the Admin container.
V2_DOCKER_SOCKET_PATH=/var/run/docker.sock
V2_RUNTIME_READ_ONLY=true
V2_ADMIN_DOCKER_HOST=unix:///var/run/cpa-docker-read/docker.sock
V2_ADMIN_DOCKER_SOCKET_PATH=/dev/null

# A final approved cutover must explicitly set V2_RUNTIME_READ_ONLY=false,
# V2_ADMIN_DOCKER_HOST=unix:///var/run/docker-direct.sock, and
# V2_ADMIN_DOCKER_SOCKET_PATH=/var/run/docker.sock. Do not use those values for
# read-only validation because they grant account/runtime mutation capability.

# Existing business CPA runtime that remains upstream of Go v2.
V2_LIVE_COMPOSE_PROJECT=cliproxy-multi
V2_LIVE_INSTANCE_NAME=cliproxy
V2_UPSTREAM_NETWORK=cliproxy-backend
