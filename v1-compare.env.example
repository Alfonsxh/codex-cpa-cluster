# Exact immutable Python/OpenResty v1 images built from one main-branch revision.
V1_COMPARE_ADMIN_IMAGE=ghcr.io/owner/codex-cpa-admin:sha256-example
V1_COMPARE_WEB_IMAGE=ghcr.io/owner/codex-cpa-web:sha256-example
V1_COMPARE_GATEWAY_IMAGE=ghcr.io/owner/codex-cpa-gateway:sha256-example
V1_COMPARE_EDGE_IMAGE=ghcr.io/owner/codex-cpa-edge:sha256-example
V1_COMPARE_DOCKER_READ_PROXY_IMAGE=ghcr.io/owner/codex-cpa-v2-control:sha256-example
V1_COMPARE_SOURCE_REVISION=0000000000000000000000000000000000000000

# A disposable state copy with .v2-isolated-copy.json, never the live v1 root.
V1_COMPARE_DEPLOY_ROOT=/path/to/isolated-v1-copy
V1_COMPARE_COMPOSE_PROJECT_NAME=cliproxy-v1-compare
V1_COMPARE_INSTANCE_NAME=cliproxy-v1-compare

# Both comparison gateways must use the same disposable CPA upstream project.
# The deployment script rejects a network without io.codex-cpa.scope=migration-disposable,
# a live/broad upstream root, or containers whose bind mounts escape that root.
V1_COMPARE_UPSTREAM_NETWORK=cliproxy-v2-candidate-data-upstream
V1_COMPARE_UPSTREAM_DEPLOY_ROOT=/path/to/isolated-v2-candidate-copy
V1_COMPARE_CONFIRM_UPSTREAM_DEPLOY_ROOT=/path/to/isolated-v2-candidate-copy

# Keep loopback by default. A LAN bind requires an explicit operator decision.
V1_COMPARE_PUBLIC_BIND_ADDRESS=127.0.0.1
V1_COMPARE_PUBLIC_PROBE_HOST=127.0.0.1
V1_COMPARE_PUBLIC_PORT=19317
V1_COMPARE_INTERNAL_PORT=19316

# The adapter can read only the selected disposable upstream Compose project.
# Its proxy rejects every Docker mutation; the v1 Admin never receives the host
# socket directly.
V1_COMPARE_HOST_DOCKER_SOCKET_PATH=/var/run/docker.sock
V1_COMPARE_LIVE_COMPOSE_PROJECT=cliproxy-v2-candidate-data
